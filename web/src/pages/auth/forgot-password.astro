---
import AuthLayout from '../../layouts/AuthLayout.astro';
---
<AuthLayout title="Forgot password" variant="forgot" logoAlign="left">
  <a class="auth-logo" href="/" aria-label="Cre-Vision home">
    <img src="/logo%26text.svg" alt="Cre-Vision UX&amp;UI DESIGN" width="200" height="48" />
  </a>

  <div class="auth-card auth-card--forgot">
    <h1>Forgot Password</h1>
    <p class="auth-lead">
      Enter your email address and we'll send you a link to reset your password.
    </p>

    <form id="forgot-form" method="post" action="#" novalidate>
      <div class="auth-field">
        <label for="reset-email">Email Address</label>
        <input
          class="auth-input"
          id="reset-email"
          name="email"
          type="email"
          autocomplete="email"
          placeholder="name@studio.com"
          required
        />
      </div>

      <button class="auth-btn" type="submit">
        Send Reset Link
        <span aria-hidden="true">→</span>
      </button>
    </form>

    <hr class="auth-card-divider" />
    <div class="auth-card-footer">
      <a class="auth-footer-link" href="/auth/login">
        <span aria-hidden="true">←</span>
        Back to login
      </a>
    </div>
  </div>
</AuthLayout>

<script>
  const form = document.getElementById('forgot-form');
  // 占位：接入「发邮件重置链接」API 前拦截提交
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
  });
</script>
