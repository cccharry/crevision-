---
import AuthLayout from '../../layouts/AuthLayout.astro';
---
<AuthLayout title="Reset password" variant="reset">
  <a class="auth-logo" href="/" aria-label="Cre-Vision home">
    <img src="/logo%26text.svg" alt="Cre-Vision UX&amp;UI DESIGN" width="200" height="48" />
  </a>

  <div class="auth-card auth-card--reset">
    <h1>Reset Password</h1>
    <p class="auth-lead">Please enter your new password.</p>

    <ul class="auth-requirements" aria-label="Password rules">
      <li>
        Minimum length: 8 characters, must include 3 or more of the following types:
        <ul>
          <li>Uppercase letters (A–Z)</li>
          <li>Lowercase letters (a–z)</li>
          <li>Numbers (0–9)</li>
          <li>Special symbols (e.g. !@#$%^&amp;*)</li>
        </ul>
      </li>
    </ul>

    <form id="reset-password-form" method="post" action="#" novalidate>
      <div class="auth-field">
        <label for="new-password">New Password</label>
        <div class="auth-input-password-wrap" data-password-toggle>
          <input
            class="auth-input"
            id="new-password"
            name="newPassword"
            type="password"
            autocomplete="new-password"
            required
            minlength="8"
          />
          <button
            class="auth-toggle-password"
            type="button"
            aria-label="Show new password"
            data-label-show="Show new password"
            data-label-hide="Hide new password"
          >
            <img
              src="/icn_backend_invisible.svg"
              alt=""
              width="24"
              height="24"
            />
          </button>
        </div>
      </div>

      <div class="auth-field">
        <label for="confirm-password">Confirm New Password</label>
        <div class="auth-input-password-wrap" data-password-toggle>
          <input
            class="auth-input"
            id="confirm-password"
            name="confirmPassword"
            type="password"
            autocomplete="new-password"
            required
            minlength="8"
          />
          <button
            class="auth-toggle-password"
            type="button"
            aria-label="Show confirm password"
            data-label-show="Show confirm password"
            data-label-hide="Hide confirm password"
          >
            <img
              src="/icn_backend_invisible.svg"
              alt=""
              width="24"
              height="24"
            />
          </button>
        </div>
      </div>

      <button class="auth-btn" type="submit">
        Confirm New Password
        <span aria-hidden="true">→</span>
      </button>
    </form>
  </div>
</AuthLayout>

<script>
  import { initPasswordVisibilityToggles } from '../../scripts/auth-password-toggle.ts';

  const form = document.getElementById('reset-password-form');
  initPasswordVisibilityToggles(document);
  // 占位：接入「带 token 更新密码」API 前拦截提交
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
  });
</script>
