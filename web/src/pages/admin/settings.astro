---
import AdminLayout from '../../layouts/AdminLayout.astro';
---
<AdminLayout title="Settings" activeNav="settings">
  <h1 class="adm-page-title">Setting</h1>
  <section class="adm-card">
    <div class="adm-section-head">
      <h2>Reset Password</h2>
    </div>
    <p style="margin: 0; color: var(--adm-muted); font-size: 0.9375rem;">
      修改密码表单可与 <a href="/auth/reset-password" style="color: var(--adm-purple);">找回密码流程</a> 或独立账户 API
      对接；此处为占位。
    </p>
  </section>
</AdminLayout>
