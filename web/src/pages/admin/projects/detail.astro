---
import AdminLayout from '../../../layouts/AdminLayout.astro';
---
<AdminLayout title="Project details" activeNav="projects">
  <nav class="adm-crumb" aria-label="面包屑">
    <a href="/admin/projects">Projects</a>
    <span class="adm-crumb-sep" aria-hidden="true">&gt;</span>
    <span class="adm-crumb-current">Project Details</span>
  </nav>

  <div class="adm-detail-head">
    <h1 class="adm-page-title adm-detail-heading" id="detail-heading">Project</h1>
    <div class="adm-detail-head-controls">
      <div class="adm-detail-toggle-row">
        <span class="adm-detail-carousel-label">Display in Homepage Carousel</span>
        <label class="adm-switch">
          <input type="checkbox" id="f-carousel" />
          <span class="adm-switch-slider"></span>
        </label>
      </div>
      <button type="button" class="adm-btn adm-btn--outline adm-btn-remove-project" id="btn-remove-project">
        <img
          src="/admin/icons/icn_backend_remove_project.svg"
          alt=""
          width="16"
          height="16"
          class="adm-toolbar-icon"
        />
        Remove Project
      </button>
    </div>
  </div>

  <div class="adm-detail-layout">
    <div class="adm-detail-main">
      <section class="adm-card">
        <div class="adm-section-head">
          <h2>Main Content</h2>
        </div>

        <div class="adm-grid2">
          <div class="adm-field">
            <label class="adm-label" for="f-title-en">EN TITLE</label>
            <input class="adm-input" id="f-title-en" autocomplete="off" />
          </div>
          <div class="adm-field">
            <label class="adm-label" for="f-title-zh">CN TITLE</label>
            <input class="adm-input" id="f-title-zh" autocomplete="off" />
          </div>
        </div>
        <div class="adm-grid2">
          <div class="adm-field">
            <label class="adm-label" for="f-slug">Slug</label>
            <input class="adm-input" id="f-slug" autocomplete="off" />
          </div>
          <div class="adm-field">
            <label class="adm-label" for="f-year">Time</label>
            <select class="adm-select" id="f-year"></select>
          </div>
        </div>
        <div class="adm-field">
          <label class="adm-label" for="f-services">Type of Work（逗号分隔）</label>
          <input class="adm-input" id="f-services" autocomplete="off" />
        </div>

        <div class="adm-field adm-lead-image-field">
          <div class="adm-lead-image-bar">
            <span class="adm-lead-image-label">Lead Image</span>
            <input
              type="file"
              id="f-hero-file"
              accept="image/*"
              class="adm-hero-file-input"
              aria-hidden="true"
              tabindex="-1"
            />
            <button type="button" class="adm-btn-lead-image" id="btn-hero-upload">
              <img
                src="/admin/icons/icn_backend_add_project.svg"
                alt=""
                width="18"
                height="18"
                class="adm-btn-lead-image-icon"
                id="hero-btn-icon"
              />
              <span id="hero-btn-text">Add Image</span>
            </button>
          </div>
          <div id="hero-preview-wrap" class="adm-hero-preview-wrap" hidden>
            <div class="adm-upload-frame adm-upload-frame--3-2">
              <img id="hero-preview" class="adm-upload-cover" alt="" />
            </div>
          </div>
        </div>

        <h3 class="adm-subsection-title">项目介绍</h3>
        <div class="adm-field">
          <label class="adm-label" for="f-intro-en">EN</label>
          <textarea class="adm-textarea" id="f-intro-en" rows="4"></textarea>
        </div>
        <div class="adm-field">
          <label class="adm-label" for="f-intro-zh">CN</label>
          <textarea class="adm-textarea" id="f-intro-zh" rows="4"></textarea>
        </div>

        <h3 class="adm-subsection-title">列表短描述</h3>
        <div class="adm-grid2">
          <div class="adm-field">
            <label class="adm-label" for="f-sum-en">EN Summary</label>
            <textarea class="adm-textarea" id="f-sum-en" rows="3"></textarea>
          </div>
          <div class="adm-field">
            <label class="adm-label" for="f-sum-zh">CN Summary</label>
            <textarea class="adm-textarea" id="f-sum-zh" rows="3"></textarea>
          </div>
        </div>
      </section>

      <div class="adm-detail-page-footer">
        <button type="button" class="adm-btn adm-btn--primary" id="btn-save">Save</button>
        <button type="button" class="adm-btn adm-btn--outline" id="btn-detail-cancel">Cancel</button>
      </div>

      <div id="sections-root"></div>
    </div>

    <aside class="adm-detail-aside">
      <div class="adm-card adm-aside-sticky">
        <div class="adm-section-head" style="margin-bottom: 12px;">
          <h2 style="font-size: 1rem;">Add Section</h2>
        </div>
        <p style="font-size: 0.8125rem; color: var(--adm-muted); margin: 0 0 12px;">
          从右侧点选板块后在下方出现对应内容区；已添加的板块在列表中会变为灰色且不可再点。
        </p>
        <ul id="section-picker-list" style="list-style: none; margin: 0; padding: 0;"></ul>
      </div>
    </aside>
  </div>
</AdminLayout>

<style is:global>
  .adm-crumb {
    margin-bottom: 10px;
    font-size: 0.8125rem;
    color: var(--adm-muted);
  }

  .adm-crumb a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .adm-crumb a:hover {
    color: var(--adm-text);
  }

  .adm-crumb-sep {
    margin: 0 6px;
    font-weight: 500;
    color: var(--adm-muted);
    text-decoration: none;
  }

  .adm-crumb-current {
    color: var(--adm-muted);
  }

  .adm-detail-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px 24px;
    flex-wrap: wrap;
    margin-bottom: 20px;
  }

  .adm-detail-heading {
    margin: 0;
    flex: 1;
    min-width: min(100%, 280px);
  }

  .adm-detail-head-controls {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-shrink: 0;
  }

  .adm-detail-toggle-row {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .adm-detail-carousel-label {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--adm-purple);
    white-space: nowrap;
  }

  .adm-btn.adm-btn--outline.adm-btn-remove-project {
    color: #374151;
  }

  .adm-btn.adm-btn--outline.adm-btn-remove-project:hover {
    color: #111827;
    border-color: #d1d5db;
    background: #f9fafb;
  }

  @media (max-width: 720px) {
    .adm-detail-head {
      flex-direction: column;
      align-items: stretch;
    }

    .adm-detail-head-controls {
      justify-content: flex-end;
      flex-wrap: wrap;
    }

    .adm-detail-carousel-label {
      white-space: normal;
    }
  }

  .adm-detail-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 280px;
    gap: 24px;
    align-items: start;
  }

  /** 与新建项目弹窗底部一致：独立于 Main Content 白卡片，右对齐 */
  .adm-detail-page-footer {
    display: flex;
    justify-content: flex-end;
    gap: 10px;
    margin-top: 12px;
    margin-bottom: 28px;
    padding: 0 2px;
  }

  .adm-detail-aside {
    min-width: 0;
  }

  .adm-aside-sticky {
    position: sticky;
    top: 20px;
  }

  .adm-subsection-title {
    margin: 24px 0 12px;
    font-size: 0.9375rem;
    font-weight: 600;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--adm-border);
  }

  .adm-toolbar-icon {
    flex-shrink: 0;
    display: block;
    object-fit: contain;
  }

  .adm-lead-image-field {
    margin-bottom: 16px;
  }

  .adm-lead-image-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 10px 12px;
    border: 1px solid var(--adm-border);
    border-radius: 8px;
    background: #fff;
  }

  .adm-lead-image-label {
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--adm-muted);
  }

  .adm-hero-file-input {
    position: absolute;
    width: 0;
    height: 0;
    opacity: 0;
    pointer-events: none;
  }

  .adm-btn-lead-image {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin: 0;
    padding: 4px 2px;
    font-family: inherit;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--adm-purple);
    background: transparent;
    border: none;
    cursor: pointer;
    border-radius: 4px;
  }

  .adm-btn-lead-image:hover {
    opacity: 0.88;
  }

  .adm-btn-lead-image:focus-visible {
    outline: 2px solid var(--adm-purple);
    outline-offset: 2px;
  }

  .adm-btn-lead-image-icon {
    flex-shrink: 0;
    display: block;
    object-fit: contain;
  }

  .adm-hero-preview-wrap {
    margin-top: 12px;
    border-radius: 8px;
    overflow: hidden;
  }

  @media (max-width: 960px) {
    .adm-detail-layout {
      grid-template-columns: 1fr;
    }
    .adm-aside-sticky {
      position: static;
    }
  }

  .adm-sec-picker-btn {
    display: flex;
    align-items: center;
    gap: 10px;
    width: 100%;
    justify-content: flex-start;
    padding: 10px 12px;
    font-size: 0.875rem;
    font-weight: 500;
  }

  .adm-sec-picker-icon {
    flex-shrink: 0;
    width: 24px;
    height: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.1rem;
    line-height: 1;
  }

  .adm-sec-picker-icon img {
    width: 22px;
    height: 22px;
    object-fit: contain;
    display: block;
  }

  .adm-sec-picker-btn.is-used {
    opacity: 1;
    cursor: not-allowed;
    pointer-events: none;
    color: #a3a3a3;
  }

  .adm-sec-picker-btn.is-used .adm-sec-picker-icon img {
    opacity: 0.9;
    filter: grayscale(1) brightness(0.92);
  }

  /* 各 Section 卡片顶栏（与设计稿一致） */
  .adm-sec-card-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }

  .adm-sec-card-head-left {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
  }

  .adm-sec-card-icon {
    width: 24px;
    height: 24px;
    flex-shrink: 0;
    object-fit: contain;
    display: block;
  }

  .adm-sec-card-title {
    margin: 0;
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--adm-text);
  }

  .adm-sec-card-head-right {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-shrink: 0;
  }

  .adm-sec-head-sep {
    width: 1px;
    height: 20px;
    background: var(--adm-border);
    flex-shrink: 0;
  }

  .adm-sec-display-toggle {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    cursor: pointer;
    user-select: none;
  }

  .adm-sec-display-label {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--adm-purple);
  }

  .adm-btn.adm-btn--outline.adm-btn-sec-remove {
    display: inline-flex;
    align-items: center;
    color: #374151;
    gap: 6px;
  }

  .adm-btn.adm-btn--outline.adm-btn-sec-remove:hover {
    color: #111827;
    border-color: #d1d5db;
    background: #f9fafb;
  }

  .adm-sec-remove-icon {
    display: block;
    flex-shrink: 0;
  }

  .adm-sec-card-divider {
    height: 1px;
    background: var(--adm-purple);
    margin: 12px 0 18px;
    border: none;
  }

  .adm-sec-block-actions {
    display: flex;
    gap: 8px;
    margin-top: 16px;
    flex-wrap: wrap;
  }

  .adm-block-text,
  .adm-block-img {
    margin-bottom: 20px;
  }

  .adm-block-text-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 12px;
  }

  .adm-block-text-label {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--adm-muted);
  }

  .adm-btn-text-block-remove {
    font-size: 0.75rem;
    padding: 4px 10px;
  }

  .adm-section-editor textarea::placeholder,
  .adm-section-editor input::placeholder {
    color: #a3a3a3;
  }

  .adm-images-panel {
    border: 1px solid var(--adm-border);
    border-radius: 8px;
    background: #fff;
    overflow: hidden;
  }

  .adm-images-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 12px 14px;
    border-bottom: 1px solid var(--adm-border);
    background: #fff;
  }

  .adm-images-bar-label {
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--adm-muted);
  }

  .adm-btn-add-images {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin: 0;
    padding: 0;
    font-family: inherit;
    font-size: 0.875rem;
    font-weight: 600;
    color: #111827;
    background: transparent;
    border: none;
    cursor: pointer;
    border-radius: 4px;
  }

  .adm-btn-add-images:hover {
    opacity: 0.85;
  }

  .adm-btn-add-images:focus-visible {
    outline: 2px solid var(--adm-purple);
    outline-offset: 2px;
  }

  .adm-btn-add-images-plus {
    font-size: 1.125rem;
    line-height: 1;
    font-weight: 500;
  }

  .adm-images-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
    gap: 12px;
    padding: 14px;
    min-height: 100px;
    background: #fafafa;
  }

  .adm-images-grid.is-empty {
    min-height: 120px;
  }

  .adm-img-tile {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .adm-btn-img-tile-remove {
    font-size: 0.75rem;
    padding: 4px 8px;
    align-self: flex-start;
  }

  .adm-section-pb .adm-pb-ta {
    min-height: 140px;
    font-size: 0.9375rem;
    line-height: 1.55;
  }
</style>

<script>
  import { bootAdminProjectDetail } from '../../../scripts/admin-project-detail.ts';
  import { bootAdminApp } from '../../../scripts/admin-guard.ts';

  const yearSel = document.getElementById('f-year') as HTMLSelectElement | null;
  const y0 = new Date().getFullYear();
  if (yearSel) {
    for (let y = y0 + 1; y >= 2000; y--) {
      const op = document.createElement('option');
      op.value = String(y);
      op.textContent = String(y);
      yearSel.appendChild(op);
    }
  }

  void (async () => {
    const mode = await bootAdminApp();
    if (mode === 'redirecting') return;
    bootAdminProjectDetail();
  })();
</script>
