---
/** 站点根路径：作品展示首页（与 /projects 相同数据源与列表逻辑） */
const siteTitle = 'Cre-Vision';
---
<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{siteTitle} · 作品</title>
    <style>
      body {
        font-family: system-ui, -apple-system, 'Segoe UI', sans-serif;
        max-width: 48rem;
        margin: 2rem auto;
        padding: 0 1rem;
        line-height: 1.5;
        color: #111;
      }
      .site-head {
        margin-bottom: 1.75rem;
      }
      .site-head h1 {
        margin: 0 0 0.35rem;
        font-size: clamp(1.5rem, 4vw, 2rem);
        font-weight: 700;
        letter-spacing: -0.02em;
      }
      .site-head p {
        margin: 0;
        font-size: 0.9375rem;
        color: #6b7280;
      }
      .warn {
        background: #fff3cd;
        padding: 0.75rem 1rem;
        border-radius: 6px;
        margin-bottom: 1rem;
      }
      ul {
        padding-left: 0;
        list-style: none;
        margin: 0;
      }
      .thumb {
        width: 120px;
        aspect-ratio: 3 / 2;
        object-fit: cover;
        border-radius: 6px;
        background: #e5e7eb;
        vertical-align: middle;
        margin-right: 12px;
        flex-shrink: 0;
      }
      li {
        margin: 12px 0;
        display: flex;
        align-items: center;
      }
      li a {
        color: #111;
        font-weight: 500;
        text-decoration: none;
      }
      li a:hover {
        text-decoration: underline;
      }
      .meta {
        margin-top: 1.5rem;
        font-size: 0.875rem;
        color: #6b7280;
      }
      .foot {
        margin-top: 2rem;
        padding-top: 1rem;
        border-top: 1px solid #e5e7eb;
        font-size: 0.8125rem;
      }
      .foot a {
        color: #6b7280;
      }
    </style>
  </head>
  <body>
    <header class="site-head">
      <h1>{siteTitle}</h1>
      <p>作品集 · 从云端同步展示的项目</p>
    </header>

    <div id="root">
      <p>加载中…</p>
    </div>

    <p class="meta" id="updated-line" hidden></p>

    <footer class="foot">
      <a href="/admin">站点管理</a>
    </footer>

    <script>
      import { fetchPublicProjects, projectTitle, type PublicProject } from '../scripts/public-cms-projects.ts';

      const root = document.getElementById('root');
      const updatedLine = document.getElementById('updated-line');

      function esc(s: string): string {
        const d = document.createElement('div');
        d.textContent = s;
        return d.innerHTML;
      }

      void (async () => {
        if (!root) return;
        const { projects, updatedAt } = await fetchPublicProjects();
        if (projects.length === 0) {
          root.innerHTML = `<div class="warn">
            暂无展示中的案例。请在 <a href="/admin/projects">管理后台</a> 创建或编辑项目，勾选「Projects Page」展示，并确保已配置 Cloudflare KV 与 Pages Functions。
          </div>`;
          if (updatedLine) {
            updatedLine.hidden = false;
            updatedLine.textContent = `数据更新时间：${updatedAt || '—'}`;
          }
          return;
        }
        const items = projects
          .map((p: PublicProject) => {
            const slug = String(p.slug || '').trim();
            const href = `/projects/view?slug=${encodeURIComponent(slug)}`;
            const thumb = p.heroImageDataUrl
              ? `<img class="thumb" src="${esc(String(p.heroImageDataUrl))}" alt="" />`
              : `<span class="thumb" aria-hidden="true"></span>`;
            return `<li>${thumb}<a href="${href}">${esc(projectTitle(p))}</a></li>`;
          })
          .join('');
        root.innerHTML = `<ul>${items}</ul>`;
        if (updatedLine) {
          updatedLine.hidden = false;
          updatedLine.textContent = `数据更新时间：${updatedAt || '—'}`;
        }
      })();
    </script>
  </body>
</html>
